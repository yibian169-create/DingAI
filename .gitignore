# ===== deyingding-php 开源忽略规则 =====

# 运维调试工具（含免认证重置管理员密码，严禁提交 / 部署到生产）
tools/

# 数据库配置（安装向导自动生成，含真实账号密码，严禁提交）
config.php

# 安装锁文件（含安装时间，且会阻止重新安装）
install.lock

# 主密钥文件（落于 web 根之外，亦不提交）
.app_secret

# 用户上传的图片（仅保留 .htaccess 拒绝脚本执行）
uploads/*
!uploads/.htaccess

# 日志 / 缓存 / 运行时
*.log
/logs/
/cache/
/runtime/

# 编辑器 / 系统临时文件
.DS_Store
Thumbs.db
*.swp
*.swo
~*

# 依赖（本项目零 Composer 依赖；若未来引入则启用）
/vendor/
composer.lock
